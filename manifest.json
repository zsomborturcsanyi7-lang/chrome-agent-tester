{
  "manifest_version": 3,
  "name": "Cognitive Session Engine",
  "version": "1.0.0",
  "description": "AI-driven semantic workspace for deep work and research.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab",
    "contextMenus",
    "history"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Cognitive Session Engine"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
